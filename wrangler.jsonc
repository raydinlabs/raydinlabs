{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raydinlabs",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/blog",
      "/blog.html",
      "/content",
      "/content.html"
    ]
  },
  "main": "server/worker.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raydinlabs-content",
      "database_id": "4efe0663-a82a-4a85-ad7d-cd9a37d2c798",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "raydinlabs-media"
    }
  ],
  "vars": {
    "ADMIN_USERNAME": "kxizen",
    "RESEND_FROM": "Raydin Labs <website@raydinlabs.org>",
    "RESEND_TEMPLATE_ID": "352ff4ec-f8f9-4058-90e3-efaa20774cb9"
  }
}
