{
  "name": "raydinlabs-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev --port 4173",
    "test": "node --test tests/*.test.mjs",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "dev:full": "wrangler dev",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "setup:admin": "node scripts/setup-admin.mjs",
    "setup:email-secret": "node scripts/setup-email-secret.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "wrangler": "4.151.2"
  },
  "dependencies": {
    "resend": "^6.34.1"
  }
}
